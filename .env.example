# Copy this file to .env and fill in the required values.
# cp .env.example .env

# ── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=mlops

# ── MLflow ──────────────────────────────────────────────────────────────────
# Shared across all services — must match the mlflow service name in docker-compose
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_UI_PORT=5001
MODEL_NAME=bank-marketing-classifier

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Agent ───────────────────────────────────────────────────────────────────
# Set to "true" to run without an API key (rule-based decisions, no LLM calls)
# Set to "false" for the real demo with Claude
DEMO_MODE=false

# REQUIRED when DEMO_MODE=false — get your key from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXX

# Model to use for sub-agents (haiku is fast and cheap for classification tasks)
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── Worker ──────────────────────────────────────────────────────────────────
WORKER_MAX_RETRIES=3

# ── Model service ────────────────────────────────────────────────────────────
DRIFT_WINDOW=500
